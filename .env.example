# Copy to .env. Sections are separated by a double underscore.
COMMERCE_ENVIRONMENT=development
COMMERCE_LOG_FORMAT=pretty

# Outside docker compose: postgres://commerce:commerce@localhost:5433/commerce
COMMERCE_DATABASE__URL=postgres://commerce:commerce@localhost:5433/commerce

# Use a test-mode restricted key (rk_test_...) from the Stripe Dashboard.
COMMERCE_STRIPE__SECRET_KEY=rk_test_replace_me
# Pin to the version shown in Stripe Dashboard > Developers; upgrade deliberately.
COMMERCE_STRIPE__API_VERSION=2025-09-30.clover
# From `stripe listen --forward-to localhost:8080/webhooks/stripe`.
COMMERCE_STRIPE__WEBHOOK_SECRETS=["whsec_replace_me"]

# JWTs from Cash: Ed25519, `kid` selects the key, `x` is the base64url raw public key.
COMMERCE_AUTH__ISSUER=cash
COMMERCE_AUTH__AUDIENCE=commerce-service
COMMERCE_AUTH__PUBLIC_KEYS=[{kid="cash-dev-1",x="replace_me"}]
